---
export interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<section aria-label="Frequently asked questions">
  <h2>Frequently asked questions</h2>
  <div class="faq">
    {items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</section>
