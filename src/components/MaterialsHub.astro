---
import Base from '../layouts/Base.astro';
import { MATERIALS } from '../data/materials';
import { VENDORS } from '../data/vendors';
import { PROCESSES } from '../data/processes';
import { pickSpec, fmtVal } from '../lib/specs';
import { materialHubRow } from '../lib/payload';
import { LOCALE_META, homePath } from '../i18n/home';
import { MATERIALS_HUB_COPY, hubUrl, indexAlternates, type HubLocale } from '../i18n/hub';

// The materials database index, one component for the English page and
// the German pilot (B5). Chrome comes from i18n/hub.ts; every value in
// the table and payload comes from the shared data layer, unchanged.

interface Props {
  locale: HubLocale;
}

const { locale } = Astro.props;
const copy = MATERIALS_HUB_COPY[locale];
const meta = LOCALE_META[locale];

// Index columns are picked from the structured data layer (B1): the
// in-plane (XY / X-Y / X, dry) variant where a datasheet splits by
// orientation, and the 1.8 MPa HDT where two loads are published.
const ORIENT_PREF = ['XY', 'X-Y', 'X'];
const cell = (m: (typeof MATERIALS)[number], key: string, opts?: Parameters<typeof pickSpec>[2]) => {
  const s = pickSpec(m.structuredSpecs, key, opts);
  return s ? fmtVal(s.value) : '—';
};

// Dataset JSON-LD, generated from the data layer so the count, measured
// variables and keywords can never drift from the entries actually listed.
// Orientation/condition qualifiers on labels (X/Y, dry, printed part…) are
// normalised away; synonym labels are merged to one measured variable.
const MEASURED_RENAMES: Record<string, string> = {
  'Ultimate tensile strength': 'Tensile strength',
  'Tensile strength at break': 'Tensile strength',
  "Young's modulus": 'Tensile modulus',
  'Heat deflection temperature': 'Heat deflection temperature (HDT)',
};
const measuredName = (label: string) => {
  if (/^HDT @/.test(label)) return 'Heat deflection temperature (HDT)';
  const base = label.replace(/\s*\((?:X|Z|dry|printed part|bulk)[^)]*\)\s*$/, '').trim();
  return MEASURED_RENAMES[base] ?? base;
};
const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: copy.datasetName,
  description: copy.datasetDescription.replaceAll('{materials}', String(MATERIALS.length)),
  url: hubUrl(locale, '/materials/'),
  creator: { '@id': 'https://nylon3dp.com/#organization' },
  // Reuse terms for this compiled dataset live on the site's Terms page
  // (values remain the manufacturers'; see the footer sourcing note).
  license: 'https://nylon3dp.com/terms/',
  // Entries carry no per-entry date field in the data layer; this is the
  // database's last editorial update and moves with each database batch.
  dateModified: '2026-11-17',
  variableMeasured: [...new Set(MATERIALS.flatMap((m) => m.properties.map((p) => measuredName(p.label))))].sort(),
  keywords: [
    'Nylon 3D printing',
    ...new Set(MATERIALS.map((m) => m.basePolymer)),
    ...new Set(MATERIALS.map((m) => m.process)),
    'Technical data sheet',
  ],
};

// B2 database UX: filter/sort payload, serialised from structuredSpecs at
// build time for the hub island (lib/hub-client.ts). The static table
// below is the full database — the island only enhances it. The `ui`
// strings localize the island's rendered text (B5).
const hubPayload = {
  kind: 'materials',
  noun: copy.noun,
  compareBase: '/compare/materials/',
  ui: copy.ui,
  rows: Object.fromEntries(MATERIALS.map((m) => [m.slug, materialHubRow(m)])),
};
const presentIn = <T,>(values: T[]): T[] => [...new Set(values)];
const processOptions = PROCESSES.filter((p) => MATERIALS.some((m) => m.processSlug === p.slug));
const polymerOptions = presentIn(MATERIALS.map((m) => m.basePolymer)).sort();
const formOptions = presentIn(MATERIALS.map((m) => m.form));
const vendorOptions = VENDORS.filter((v) => MATERIALS.some((m) => m.vendorSlug === v.slug));
const fillerOptions = presentIn(MATERIALS.map((m) => materialHubRow(m).f.filler));
const COLUMN_DEFS = [
  { key: 'name', num: false },
  { key: 'manufacturer', num: false },
  { key: 'polymer', num: false },
  { key: 'form', num: false },
  { key: 'process', num: false },
  { key: 'tensileStrength', num: true },
  { key: 'tensileModulus', num: true },
  { key: 'elongationAtBreak', num: true },
  { key: 'hdt', num: true },
  { key: 'density', num: true },
];
const COLUMNS = COLUMN_DEFS.map((c, i) => ({ ...c, label: copy.columns[i] }));
const coverageHtml = copy.coverageHtml
  .replaceAll('{materials}', String(MATERIALS.length))
  .replaceAll('{makers}', [...new Set(MATERIALS.map((m) => m.manufacturer))].join(', '));
---

<Base
  title={copy.title}
  description={copy.description}
  lang={meta.htmlLang}
  ogLocale={locale === 'en' ? undefined : meta.ogLocale}
  inLanguage={meta.htmlLang}
  alternates={indexAlternates('/materials/')}
  jsonLd={datasetLd}
>
  <div class="hub-band">
    <p class="crumbs"><a href={homePath(locale)}>{copy.crumbHome}</a> / {copy.crumbHere}</p>
    <h1>{copy.h1}</h1>
  </div>
  <div class="quick-answer">
    <p class="qa-label">{copy.qaLabel}</p>
    <p>{copy.qaBody}</p>
  </div>

  <p set:html={coverageHtml} />

  <h2>{copy.allHeading}</h2>
  <p set:html={copy.allIntroHtml} />
  <div data-hub>
    <form class="filter-bar" data-filter-form>
      <div class="filter-field">
        <label for="f-process">{copy.filters.process}</label>
        <select id="f-process" data-filter="process">
          <option value="">{copy.filters.allProcesses}</option>
          {processOptions.map((p) => <option value={p.slug}>{p.name}</option>)}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-polymer">{copy.filters.polymer}</label>
        <select id="f-polymer" data-filter="polymer">
          <option value="">{copy.filters.allPolymers}</option>
          {polymerOptions.map((p) => <option value={p}>{p}</option>)}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-form">{copy.filters.form}</label>
        <select id="f-form" data-filter="form">
          <option value="">{copy.filters.allForms}</option>
          {formOptions.map((f) => <option value={f}>{copy.filters.formLabels[f] ?? f}</option>)}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-vendor">{copy.filters.vendor}</label>
        <select id="f-vendor" data-filter="vendor">
          <option value="">{copy.filters.allVendors}</option>
          {vendorOptions.map((v) => <option value={v.slug}>{v.name}</option>)}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-filler">{copy.filters.filler}</label>
        <select id="f-filler" data-filter="filler">
          <option value="">{copy.filters.allFiller}</option>
          {fillerOptions.map((f) => <option value={f}>{copy.filters.fillerLabels[f] ?? f}</option>)}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-ts">{copy.filters.tsLabel}</label>
        <input id="f-ts" type="number" min="0" step="any" inputmode="decimal" placeholder={copy.filters.tsPlaceholder} data-filter-num="ts" />
      </div>
      <div class="filter-field">
        <label for="f-hdt">{copy.filters.hdtLabel}</label>
        <input id="f-hdt" type="number" min="0" step="any" inputmode="decimal" placeholder={copy.filters.hdtPlaceholder} data-filter-num="hdt" />
      </div>
      <div class="filter-actions">
        <button type="button" class="btn" data-reset>{copy.reset}</button>
        <p class="result-count" data-count aria-live="polite">{MATERIALS.length} {copy.noun}</p>
      </div>
    </form>
    <div class="compare-bar" data-compare-bar hidden>
      <span data-compare-count></span>
      <a class="btn" data-compare-link href="/compare/materials/">{copy.compareSelected}</a>
      <button type="button" class="btn btn-quiet" data-compare-clear>{copy.clearSelection}</button>
    </div>
    <div class="table-scroll">
      <table class="data-table hub-table">
        <thead>
          <tr>
            <th scope="col" class="cmp-col"><span class="sr-only">{copy.compareSr}</span></th>
            {COLUMNS.map((c) => (
              <th scope="col" class={c.num ? 'num-col' : undefined}>
                <button type="button" class="th-sort" data-sort={c.key}>{c.label}<span class="sort-ind" aria-hidden="true"></span></button>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {MATERIALS.map((m) => (
            <tr data-slug={m.slug}>
              <td class="cmp-cell"><input type="checkbox" class="cmp-check" value={m.slug} aria-label={copy.compareAria.replace('{name}', m.name)} /></td>
              <td><a href={`/materials/${m.slug}/`}>{m.name}</a></td>
              <td>{m.manufacturer}</td>
              <td>{m.basePolymer}</td>
              <td>{copy.filters.formLabels[m.form] ?? m.form}</td>
              <td>{m.process}</td>
              <td class="num">{cell(m, 'tensileStrength', { orientations: ORIENT_PREF })}</td>
              <td class="num">{cell(m, 'tensileModulus', { orientations: ORIENT_PREF })}</td>
              <td class="num">{cell(m, 'elongationAtBreak', { orientations: ORIENT_PREF })}</td>
              <td class="num">{cell(m, 'hdt', { noteIncludes: '1.8 MPa' })}</td>
              <td class="num">{cell(m, 'density')}</td>
            </tr>
          ))}
          <tr class="no-matches" data-no-matches hidden>
            <td colspan="11">{copy.noMatches} <button type="button" class="btn btn-quiet" data-reset>{copy.reset}</button></td>
          </tr>
        </tbody>
      </table>
    </div>
    <script type="application/json" data-hub-data set:html={JSON.stringify(hubPayload)} />
  </div>
  <p class="muted">{copy.afterNote}</p>

  <h2>{copy.howHeading}</h2>
  <p set:html={copy.howBodyHtml} />
  <p class="updated">{copy.updatedLine}</p>
  <script>
    import '../lib/hub-client';
  </script>
</Base>
