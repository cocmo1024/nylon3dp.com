---
import PortalHome from '../../components/PortalHome.astro';
import { PORTAL_COPY, LOCALE_CODES, type LocaleCode } from '../../i18n/home';

export function getStaticPaths() {
  return LOCALE_CODES.map((code) => ({ params: { locale: code } }));
}

const locale = Astro.params.locale as LocaleCode;
---

<PortalHome copy={PORTAL_COPY[locale]} locale={locale} />
