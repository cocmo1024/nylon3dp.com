---
import Base from '../../layouts/Base.astro';
import { MACHINES } from '../../data/machines';
import { VENDORS } from '../../data/vendors';
import { PROCESSES } from '../../data/processes';
import { pickSpec, fmtSpec, buildVolumeString } from '../../lib/specs';
import { machineHubRow } from '../../lib/payload';

// Index columns come from the structured data layer (B1). Layer
// thickness falls back to the legacy spec string where the values are a
// manufacturer list rather than a single figure (EOS P 396, see B0).
const layerCell = (m: (typeof MACHINES)[number]) => {
  const s = pickSpec(m.structuredSpecs, 'layerThickness');
  if (s) return fmtSpec(s);
  return m.specs.find((x) => /layer/i.test(x.label))?.value ?? 'Not stated by manufacturer';
};
const laserCell = (m: (typeof MACHINES)[number]) => {
  const s = pickSpec(m.structuredSpecs, 'laserPower');
  return s ? fmtSpec(s) : '—';
};
const capacityCell = (m: (typeof MACHINES)[number]) => {
  const s = pickSpec(m.structuredSpecs, 'buildVolumeCapacity');
  return s ? fmtSpec(s) : '—';
};

// Dataset JSON-LD, generated from the data layer so the count, measured
// variables and keywords can never drift from the entries actually listed.
const MEASURED_RENAMES: Record<string, string> = {
  'Effective build volume': 'Build volume',
  'Effective build size': 'Build volume',
};
const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Nylon 3D Printing Machines Database',
  description: `Manufacturer-verified specifications for ${MACHINES.length} nylon-capable 3D printers — SLS, MJF and SAF powder-bed systems. Every specification is taken from the manufacturer's own specification sheet or product documentation, and the source document is cited on each entry page; specifications a manufacturer does not state are omitted rather than estimated.`,
  url: 'https://nylon3dp.com/machines/',
  creator: { '@id': 'https://nylon3dp.com/#organization' },
  // Entries carry no per-entry date field in the data layer; this is the
  // database's last editorial update and moves with each database batch.
  dateModified: '2026-11-14',
  variableMeasured: [
    ...new Set(MACHINES.flatMap((m) => m.specs.map((s) => MEASURED_RENAMES[s.label] ?? s.label))),
  ].sort(),
  keywords: [
    'Nylon 3D printers',
    ...new Set(MACHINES.map((m) => m.process)),
    'Manufacturer specification sheet',
  ],
};

// B2 database UX: filter/sort payload for the hub island (see the
// materials index for the pattern; payloads come from structuredSpecs).
const hubPayload = {
  kind: 'machines',
  noun: 'machines',
  compareBase: '/compare/machines/',
  rows: Object.fromEntries(MACHINES.map((m) => [m.slug, machineHubRow(m)])),
};
const processOptions = PROCESSES.filter((p) => MACHINES.some((m) => m.processSlug === p.slug));
const vendorOptions = VENDORS.filter((v) => MACHINES.some((m) => m.vendorSlug === v.slug));
const COLUMNS = [
  { key: 'name', label: 'Machine', num: false },
  { key: 'manufacturer', label: 'Manufacturer', num: false },
  { key: 'process', label: 'Process', num: false },
  { key: 'buildVolume', label: 'Build volume X × Y × Z (mm)', num: true },
  { key: 'capacity', label: 'Build capacity', num: true },
  { key: 'layerThickness', label: 'Layer thickness', num: true },
  { key: 'laserPower', label: 'Laser power', num: true },
];
---

<Base
  title="Nylon 3D Printer Database — SLS, MJF & SAF Machines | Nylon3DP"
  description="Manufacturer-verified specs for nylon printers: HP Jet Fusion 5200 (MJF), EOS P 396 and Formiga P 110, Formlabs Fuse 1+ 30W (SLS), Stratasys H350 (SAF)."
  jsonLd={datasetLd}
>
  <div class="hub-band">
    <p class="crumbs"><a href="/">Home</a> / Machines</p>
    <h1>Nylon 3D printer database</h1>
  </div>
  <div class="quick-answer">
    <p class="qa-label">Quick answer</p>
    <p>Professional nylon printing runs on powder-bed machines: SLS systems from EOS and Formlabs, HP's MJF platform, and Stratasys's SAF production printer. This database lists each machine's build volume, layer thickness and energy source exactly as the manufacturer states them.</p>
  </div>

  <p>Coverage so far: {MACHINES.length} machines. The database expands toward the full landscape of nylon-capable systems — industrial SLS, MJF and SAF platforms first, then high-temperature FDM machines — and a machine is only listed once its specification sheet has been verified against the manufacturer's own documents.</p>

  <h2>All machines</h2>
  <p>Filter and sort the database below, or tick up to four machines and open them in the <a href="/compare/machines/">machine comparison tool</a> for a full side-by-side specification table.</p>
  <div data-hub>
    <form class="filter-bar" data-filter-form>
      <div class="filter-field">
        <label for="m-process">Process</label>
        <select id="m-process" data-filter="process">
          <option value="">All processes</option>
          {processOptions.map((p) => <option value={p.slug}>{p.name}</option>)}
        </select>
      </div>
      <div class="filter-field">
        <label for="m-vendor">Manufacturer</label>
        <select id="m-vendor" data-filter="vendor">
          <option value="">All manufacturers</option>
          {vendorOptions.map((v) => <option value={v.slug}>{v.name}</option>)}
        </select>
      </div>
      <div class="filter-field">
        <label for="m-envelope">Min. build volume, X × Y × Z (L)</label>
        <input id="m-envelope" type="number" min="0" step="any" inputmode="decimal" placeholder="e.g. 20" data-filter-num="envelopeL" />
      </div>
      <div class="filter-actions">
        <button type="button" class="btn" data-reset>Reset filters</button>
        <p class="result-count" data-count aria-live="polite">{MACHINES.length} machines</p>
      </div>
    </form>
    <div class="compare-bar" data-compare-bar hidden>
      <span data-compare-count></span>
      <a class="btn" data-compare-link href="/compare/machines/">Compare selected</a>
      <button type="button" class="btn btn-quiet" data-compare-clear>Clear selection</button>
    </div>
    <div class="table-scroll">
      <table class="data-table hub-table">
        <thead>
          <tr>
            <th scope="col" class="cmp-col"><span class="sr-only">Select to compare</span></th>
            {COLUMNS.map((c) => (
              <th scope="col" class={c.num ? 'num-col' : undefined}>
                <button type="button" class="th-sort" data-sort={c.key}>{c.label}<span class="sort-ind" aria-hidden="true"></span></button>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {MACHINES.map((m) => (
            <tr data-slug={m.slug}>
              <td class="cmp-cell"><input type="checkbox" class="cmp-check" value={m.slug} aria-label={`Compare ${m.name}`} /></td>
              <td><a href={`/machines/${m.slug}/`}>{m.name}</a></td>
              <td>{m.manufacturer}</td>
              <td>{m.process}</td>
              <td class="num">{buildVolumeString(m) ?? '—'}</td>
              <td class="num">{capacityCell(m)}</td>
              <td class="num">{layerCell(m)}</td>
              <td class="num">{laserCell(m)}</td>
            </tr>
          ))}
          <tr class="no-matches" data-no-matches hidden>
            <td colspan="8">No machines match the current filters. <button type="button" class="btn btn-quiet" data-reset>Reset filters</button></td>
          </tr>
        </tbody>
      </table>
    </div>
    <script type="application/json" data-hub-data set:html={JSON.stringify(hubPayload)} />
  </div>
  <p class="muted">Build volume is the manufacturer's effective X × Y × Z figure; the full specification set, including technology and notes, is on each machine's own page. A dash means the manufacturer does not state the value in the documents this database cites. Sorting the build-volume column orders by the X × Y × Z envelope; layer thickness sorts in µm (HP's 0.08 mm counts as 80 µm).</p>
  <p class="updated">Last updated: November 2026</p>
  <script>
    import '../../lib/hub-client';
  </script>
</Base>
