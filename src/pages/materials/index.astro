---
import Base from '../../layouts/Base.astro';
import { MATERIALS } from '../../data/materials';
import { VENDORS } from '../../data/vendors';
import { PROCESSES } from '../../data/processes';
import { pickSpec, fmtVal } from '../../lib/specs';
import { materialHubRow } from '../../lib/payload';

// Index columns are picked from the structured data layer (B1): the
// in-plane (XY / X-Y / X, dry) variant where a datasheet splits by
// orientation, and the 1.8 MPa HDT where two loads are published.
const ORIENT_PREF = ['XY', 'X-Y', 'X'];
const cell = (m: (typeof MATERIALS)[number], key: string, opts?: Parameters<typeof pickSpec>[2]) => {
  const s = pickSpec(m.structuredSpecs, key, opts);
  return s ? fmtVal(s.value) : '—';
};

// Dataset JSON-LD, generated from the data layer so the count, measured
// variables and keywords can never drift from the entries actually listed.
// Orientation/condition qualifiers on labels (X/Y, dry, printed part…) are
// normalised away; synonym labels are merged to one measured variable.
const MEASURED_RENAMES: Record<string, string> = {
  'Ultimate tensile strength': 'Tensile strength',
  'Tensile strength at break': 'Tensile strength',
  "Young's modulus": 'Tensile modulus',
  'Heat deflection temperature': 'Heat deflection temperature (HDT)',
};
const measuredName = (label: string) => {
  if (/^HDT @/.test(label)) return 'Heat deflection temperature (HDT)';
  const base = label.replace(/\s*\((?:X|Z|dry|printed part|bulk)[^)]*\)\s*$/, '').trim();
  return MEASURED_RENAMES[base] ?? base;
};
const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Nylon 3D Printing Materials Database',
  description: `Property data for ${MATERIALS.length} nylon 3D printing materials — PA11, PA12, PA6 and carbon-fibre-reinforced grades for SLS, MJF and FDM. Every value is taken from the manufacturer's own technical data sheet, and the source document is cited on each entry page; values a manufacturer does not publish are omitted rather than estimated.`,
  url: 'https://nylon3dp.com/materials/',
  creator: { '@id': 'https://nylon3dp.com/#organization' },
  // Entries carry no per-entry date field in the data layer; this is the
  // database's last editorial update and moves with each database batch.
  dateModified: '2026-11-14',
  variableMeasured: [...new Set(MATERIALS.flatMap((m) => m.properties.map((p) => measuredName(p.label))))].sort(),
  keywords: [
    'Nylon 3D printing',
    ...new Set(MATERIALS.map((m) => m.basePolymer)),
    ...new Set(MATERIALS.map((m) => m.process)),
    'Technical data sheet',
  ],
};

// B2 database UX: filter/sort payload, serialised from structuredSpecs at
// build time for the hub island (lib/hub-client.ts). The static table
// below is the full database — the island only enhances it.
const hubPayload = {
  kind: 'materials',
  noun: 'materials',
  compareBase: '/compare/materials/',
  rows: Object.fromEntries(MATERIALS.map((m) => [m.slug, materialHubRow(m)])),
};
const presentIn = <T,>(values: T[]): T[] => [...new Set(values)];
const processOptions = PROCESSES.filter((p) => MATERIALS.some((m) => m.processSlug === p.slug));
const polymerOptions = presentIn(MATERIALS.map((m) => m.basePolymer)).sort();
const formOptions = presentIn(MATERIALS.map((m) => m.form));
const vendorOptions = VENDORS.filter((v) => MATERIALS.some((m) => m.vendorSlug === v.slug));
const FILLER_LABELS: Record<string, string> = {
  Unfilled: 'Unfilled',
  GF: 'Glass-filled (GF)',
  CF: 'Carbon fibre (CF)',
  GB: 'Glass beads (GB)',
};
const fillerOptions = presentIn(MATERIALS.map((m) => materialHubRow(m).f.filler));
const sortTh = (key: string, label: string, num = false) => ({ key, label, num });
const COLUMNS = [
  sortTh('name', 'Material'),
  sortTh('manufacturer', 'Manufacturer'),
  sortTh('polymer', 'Polymer'),
  sortTh('form', 'Form'),
  sortTh('process', 'Process'),
  sortTh('tensileStrength', 'Tensile strength (MPa)', true),
  sortTh('tensileModulus', 'Tensile modulus (MPa)', true),
  sortTh('elongationAtBreak', 'Elongation at break (%)', true),
  sortTh('hdt', 'HDT (°C)', true),
  sortTh('density', 'Density (g/cm³)', true),
];
---

<Base
  title="Nylon 3D Printing Materials Database — PA11, PA12, PA6 | Nylon3DP"
  description="Datasheet-verified nylon materials: PA12, PA11, glass-filled PA12 and PA6 powders plus PA-CF and CoPA filaments from EOS, Formlabs, HP, BASF and more."
  jsonLd={datasetLd}
>
  <div class="hub-band">
    <p class="crumbs"><a href="/">Home</a> / Materials</p>
    <h1>Nylon material database</h1>
  </div>
  <div class="quick-answer">
    <p class="qa-label">Quick answer</p>
    <p>Every nylon grade in this database has its own page with a property table taken from the manufacturer's own datasheet — PA12 and PA11 powders for SLS and MJF, glass-filled grades for stiffness, and PA6-CF / CoPA filaments for FDM. No reseller numbers, no estimates: if the manufacturer does not publish a value, the table leaves it out.</p>
  </div>

  <p>Coverage so far: {MATERIALS.length} grades from {[...new Set(MATERIALS.map((m) => m.manufacturer))].join(', ')}. The database is expanding in stages toward the full nylon landscape — powders, filaments and pellets across all major suppliers — and each addition follows the same rule: a manufacturer datasheet, or it does not go in.</p>

  <h2>All materials</h2>
  <p>Filter and sort the database below, or tick up to four grades and open them in the <a href="/compare/materials/">material comparison tool</a> for a full side-by-side datasheet table.</p>
  <div data-hub>
    <form class="filter-bar" data-filter-form>
      <div class="filter-field">
        <label for="f-process">Process</label>
        <select id="f-process" data-filter="process">
          <option value="">All processes</option>
          {processOptions.map((p) => <option value={p.slug}>{p.name}</option>)}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-polymer">Polymer</label>
        <select id="f-polymer" data-filter="polymer">
          <option value="">All polymers</option>
          {polymerOptions.map((p) => <option value={p}>{p}</option>)}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-form">Form</label>
        <select id="f-form" data-filter="form">
          <option value="">All forms</option>
          {formOptions.map((f) => <option value={f}>{f}</option>)}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-vendor">Manufacturer</label>
        <select id="f-vendor" data-filter="vendor">
          <option value="">All manufacturers</option>
          {vendorOptions.map((v) => <option value={v.slug}>{v.name}</option>)}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-filler">Filler</label>
        <select id="f-filler" data-filter="filler">
          <option value="">Any filler</option>
          {fillerOptions.map((f) => <option value={f}>{FILLER_LABELS[f]}</option>)}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-ts">Min. tensile strength (MPa)</label>
        <input id="f-ts" type="number" min="0" step="any" inputmode="decimal" placeholder="e.g. 50" data-filter-num="ts" />
      </div>
      <div class="filter-field">
        <label for="f-hdt">Min. HDT at 1.8 MPa (°C)</label>
        <input id="f-hdt" type="number" min="0" step="any" inputmode="decimal" placeholder="e.g. 100" data-filter-num="hdt" />
      </div>
      <div class="filter-actions">
        <button type="button" class="btn" data-reset>Reset filters</button>
        <p class="result-count" data-count aria-live="polite">{MATERIALS.length} materials</p>
      </div>
    </form>
    <div class="compare-bar" data-compare-bar hidden>
      <span data-compare-count></span>
      <a class="btn" data-compare-link href="/compare/materials/">Compare selected</a>
      <button type="button" class="btn btn-quiet" data-compare-clear>Clear selection</button>
    </div>
    <div class="table-scroll">
      <table class="data-table hub-table">
        <thead>
          <tr>
            <th scope="col" class="cmp-col"><span class="sr-only">Select to compare</span></th>
            {COLUMNS.map((c) => (
              <th scope="col" class={c.num ? 'num-col' : undefined}>
                <button type="button" class="th-sort" data-sort={c.key}>{c.label}<span class="sort-ind" aria-hidden="true"></span></button>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {MATERIALS.map((m) => (
            <tr data-slug={m.slug}>
              <td class="cmp-cell"><input type="checkbox" class="cmp-check" value={m.slug} aria-label={`Compare ${m.name}`} /></td>
              <td><a href={`/materials/${m.slug}/`}>{m.name}</a></td>
              <td>{m.manufacturer}</td>
              <td>{m.basePolymer}</td>
              <td>{m.form}</td>
              <td>{m.process}</td>
              <td class="num">{cell(m, 'tensileStrength', { orientations: ORIENT_PREF })}</td>
              <td class="num">{cell(m, 'tensileModulus', { orientations: ORIENT_PREF })}</td>
              <td class="num">{cell(m, 'elongationAtBreak', { orientations: ORIENT_PREF })}</td>
              <td class="num">{cell(m, 'hdt', { noteIncludes: '1.8 MPa' })}</td>
              <td class="num">{cell(m, 'density')}</td>
            </tr>
          ))}
          <tr class="no-matches" data-no-matches hidden>
            <td colspan="11">No materials match the current filters. <button type="button" class="btn btn-quiet" data-reset>Reset filters</button></td>
          </tr>
        </tbody>
      </table>
    </div>
    <script type="application/json" data-hub-data set:html={JSON.stringify(hubPayload)} />
  </div>
  <p class="muted">Key values are the in-plane (XY / X) variant where a datasheet splits by orientation, and the HDT at 1.8 MPa where two loads are published. Full property sets, all orientations and test methods are on each grade's own page. Grades whose datasheet does not publish a value never pass a minimum-value filter for it.</p>

  <h2>How to read the tables</h2>
  <p>Powder datasheets from EOS use ISO 527 test methods and report "strain at break"; Formlabs and HP typically report ASTM methods. Cross-brand comparisons are therefore indicative rather than laboratory-controlled — each page keeps the manufacturer's own test method next to every value so you can judge comparability yourself. New to the grades themselves? Start with <a href="/guides/pa11-vs-pa12/">PA11 vs PA12</a> and the <a href="/glossary/">glossary</a>.</p>
  <p class="updated">Last updated: November 2026</p>
  <script>
    import '../../lib/hub-client';
  </script>
</Base>
