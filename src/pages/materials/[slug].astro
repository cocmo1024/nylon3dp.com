---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import SpecTable from '../../components/SpecTable.astro';
import Relations, { type RelatedLink } from '../../components/Relations.astro';
import { MATERIALS, type Material } from '../../data/materials';
import { MACHINES } from '../../data/machines';
import { VENDORS } from '../../data/vendors';
import { PROCESSES } from '../../data/processes';
import { materialFallbackRows, materialNoteRows } from '../../lib/specs';
import { SITE } from '../../site';

export function getStaticPaths() {
  return MATERIALS.map((m) => ({ params: { slug: m.slug }, props: { material: m } }));
}

interface Props {
  material: Material;
}
const { material: m } = Astro.props;

// Relations, resolved from the data layer (B1 rendering switch).
const vendor = VENDORS.find((v) => v.slug === m.vendorSlug)!;
const process = PROCESSES.find((p) => p.slug === m.processSlug)!;
const specifiedOn: RelatedLink[] = MACHINES.filter((mc) => mc.supportedMaterials.includes(m.slug)).map((mc) => ({
  href: `/machines/${mc.slug}/`,
  name: mc.name,
  meta: mc.process,
}));
const fallbackRows = materialFallbackRows(m);
const noteRows = materialNoteRows(m);

const title = `${m.name} Datasheet — Properties | Nylon3DP`;
const description = `${m.name}: ${m.basePolymer} ${m.form.toLowerCase()} for ${m.process} — manufacturer-sourced datasheet properties and FAQ.`;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: m.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${m.name} — ${m.basePolymer} ${m.form} for ${m.process}`,
  description,
  about: m.name,
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
---

<Base title={title} description={description} jsonLd={[articleLd, faqLd]}>
  <p class="crumbs"><a href="/">Home</a> / <a href="/materials/">Materials</a> / {m.name}</p>
  <h1>{m.name}</h1>
  <p>
    <span class="tag">{m.basePolymer}</span>
    <span class="tag">{m.form}</span>
    <span class="tag">{m.process}</span>
    <span class="tag">{m.manufacturer}</span>
  </p>
  <div class="quick-answer">
    <p class="qa-label">Quick answer</p>
    <p>{m.quickAnswer}</p>
  </div>

  {m.intro.map((para) => <p>{para}</p>)}

  <h2>Properties (manufacturer datasheet)</h2>
  <SpecTable labelHeader="Property" specs={m.structuredSpecs} fallback={fallbackRows} notes={noteRows} />
  <p class="muted">Values are reproduced from the manufacturer source(s) listed below, exactly as published. Properties the manufacturer does not publish are omitted rather than estimated — see the <a href="/editorial/">sourcing policy</a>.</p>

  <h2>Processing notes</h2>
  <ul>
    {m.processing.map((note) => <li>{note}</li>)}
  </ul>

  <h2>Typical applications</h2>
  <ul>
    {m.applications.map((app) => <li>{app}</li>)}
  </ul>

  <Relations
    vendor={vendor}
    process={process}
    relatedTitle={specifiedOn.length > 0 ? 'Machines specified for this material' : undefined}
    related={specifiedOn}
  />

  <Faq items={m.faqs} />

  <div class="sources">
    <p>Sources</p>
    <ul>
      {m.sources.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}
    </ul>
  </div>
  <p class="updated">Last updated: {SITE.lastUpdated}</p>
</Base>
