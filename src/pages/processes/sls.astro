---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';

const faq = [
  { q: 'What materials does SLS print?', a: 'Nylon dominates SLS: PA12 is the standard powder, with PA11 for more ductile parts, glass-filled PA12 for stiffness, and PA6 for higher temperature resistance. The material database lists the main grades with datasheet properties.' },
  { q: 'Does SLS need support structures?', a: 'No. The unfused powder surrounding the part supports it throughout the build, which is why SLS can produce complex internal channels, nested assemblies and moving parts in a single build.' },
  { q: 'What happens to the leftover powder?', a: 'Unfused powder is sieved and reused after being mixed with a proportion of virgin powder — the refresh ratio specified by the material manufacturer. Powder that has been thermally aged too many times is eventually discarded.' },
  { q: 'How accurate is SLS?', a: 'Accuracy depends on the machine, material and part geometry, and manufacturers state tolerances in their design guides. For design minimums such as wall thickness and hole sizes, see the designing for SLS & MJF guide, which cites the official Formlabs and HP guidelines.' },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
