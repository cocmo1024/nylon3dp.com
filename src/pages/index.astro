---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { MATERIALS } from '../data/materials';
import { MACHINES } from '../data/machines';
import { VENDORS } from '../data/vendors';
import { PROCESSES } from '../data/processes';
import { NEWS, formatNewsDate } from '../data/news';
import {
  APPLICATIONS,
  APPLICATION_INDUSTRIES,
  APPLICATION_PART_FAMILIES,
  APPLICATION_MATRIX,
} from '../data/applications';
import { SITE } from '../site';
import { ALL_LOCALES, HOME_ALTERNATES, LOCALE_META, homePath } from '../i18n/home';

// Portal front page (rebuild batch B4.5). The English homepage is the
// industry front page: lead story, news line, ecosystem, depth,
// applications landscape, and one compact data & tools module. The
// localized homepages keep the previous structure until B5 ports them.
// Counts below are always read from the data layer, never typed.

const lead = NEWS[0];
const vendorCounts = VENDORS.map((v) => ({
  vendor: v,
  materials: MATERIALS.filter((m) => m.vendorSlug === v.slug).length,
  machines: MACHINES.filter((m) => m.vendorSlug === v.slug).length,
}));
const TYPE_LABEL: Record<string, string> = {
  material: 'Materials',
  machine: 'Machines',
  both: 'Materials & machines',
};
const countLine = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

const firstSentence = (s: string) => {
  const m = s.match(/^[\s\S]*?[.!?](?=\s+[A-Z0-9"']|$)/);
  const t = (m ? m[0] : s).trim();
  return /[.!?]$/.test(t) ? t : `${t}.`;
};
const sls = PROCESSES.find((p) => p.slug === 'sls');
const mjf = PROCESSES.find((p) => p.slug === 'mjf');

const plannedCells = APPLICATION_MATRIX.filter((c) => c.status === 'candidate').length;
---

<Base
  title="The Nylon 3D Printing Industry Hub | Nylon3DP"
  description="Nylon 3D printing's industry hub: news and show coverage, the vendor ecosystem, datasheet-sourced material and machine databases, and powder-economics tools."
  alternates={HOME_ALTERNATES}
>
  <nav class="lang-nav" aria-label="Language">
    {ALL_LOCALES.map((code) => (
      <a href={homePath(code)} aria-current={code === 'en' ? 'page' : undefined}>{LOCALE_META[code].label}</a>
    ))}
  </nav>

  <section class="hero hub-band portal-masthead">
    <p class="kicker">Nylon3DP · Industry hub</p>
    <h1>The nylon 3D printing industry hub</h1>
    <p class="lede">News and show coverage, the vendor and equipment ecosystem, materials and process depth — backed by datasheet-sourced databases and powder-economics tools. If it matters to nylon 3D printing, it is covered here, with the sources attached.</p>
  </section>

  <section class="portal-section" data-section="lead">
    <p class="kicker">Lead story · {lead.tag}</p>
    <h2 class="lead-headline"><a href={lead.href}>{lead.title}</a></h2>
    <p class="dateline">{formatNewsDate(lead.date)} · Frankfurt · Preview</p>
    <p class="lead-dek">{lead.dek}</p>
    <p><a href={lead.href}>Read the watchlist</a> · <a href="/news/">All coverage</a></p>
  </section>

  <AdSlot slot="home-after-lead" />

  <section class="portal-section" data-section="news">
    <p class="kicker">News &amp; briefing</p>
    <div class="front-grid">
      <div>
        <div class="news-list">
          {NEWS.map((n) => (
            <article class="news-item">
              <p class="news-date"><time datetime={n.date}>{formatNewsDate(n.date)}</time></p>
              <div>
                <p class="news-meta"><span class="tag">{n.tag}</span></p>
                <h3 class="news-title"><a href={n.href}>{n.title}</a></h3>
                <p>{firstSentence(n.dek)}</p>
              </div>
            </article>
          ))}
        </div>
        <p><a href="/news/">The news page — how the desk works and every item so far</a></p>
      </div>
      <aside class="briefing-box">
        <p class="kicker">The briefing</p>
        <h3>Get the nylon briefing by email</h3>
        <p>Show reports, vendor moves and new database entries, collected into one occasional email. No daily noise, no third-party list. Signup is by email for now: send a note with “Subscribe” in the subject line.</p>
        <p><a class="btn" href={`mailto:${SITE.email}?subject=Subscribe%20—%20Nylon3DP%20briefing`}>Subscribe by email</a></p>
      </aside>
    </div>
  </section>

  <section class="portal-section" data-section="ecosystem">
    <p class="kicker">Ecosystem — vendors &amp; equipment</p>
    <p>The directory tracks the companies behind nylon printing — who makes the powders, who makes the machines, and what of theirs is specified in our databases. Every count below is the live state of the database, not a marketing number.</p>
    <ul class="eco-list">
      {vendorCounts.map(({ vendor: v, materials, machines }) => (
        <li>
          <span><a href={`/vendors/${v.slug}/`}>{v.name}</a> <span class="muted">· {v.hqCountry} · {TYPE_LABEL[v.type]}</span></span>
          <span class="eco-counts">{[materials > 0 ? countLine(materials, 'grade', 'grades') : null, machines > 0 ? countLine(machines, 'machine', 'machines') : null].filter(Boolean).join(' · ')}</span>
        </li>
      ))}
    </ul>
    <p><a href="/vendors/">Vendor directory</a> · <a href="/machines/">Machine database</a> — {MACHINES.length} production machines fully specified, from the EOS P 396 to the Formlabs Fuse 1+ 30W, with two more platforms being unveiled at Formnext this week.</p>
  </section>

  <section class="portal-section" data-section="depth">
    <p class="kicker">Depth — materials &amp; processes</p>
    <div class="depth-list">
      <article class="depth-item">
        <h3><a href="/processes/sls/">SLS — selective laser sintering</a></h3>
        <p>{sls ? firstSentence(sls.quickAnswer) : ''}</p>
      </article>
      <article class="depth-item">
        <h3><a href="/processes/mjf/">MJF — Multi Jet Fusion</a></h3>
        <p>{mjf ? firstSentence(mjf.quickAnswer) : ''}</p>
      </article>
      <article class="depth-item">
        <h3><a href="/guides/pa11-vs-pa12/">PA11 vs PA12: which nylon powder?</a></h3>
        <p>The ductility-versus-balance decision at the heart of powder-bed nylon, settled with EOS, Formlabs and HP datasheet numbers.</p>
      </article>
      <article class="depth-item">
        <h3><a href="/guides/designing-for-sls-mjf/">Designing parts for SLS &amp; MJF</a></h3>
        <p>Wall thickness, hole sizes and powder escape holes from the official Formlabs SLS design guide, plus the design rules both powder processes share.</p>
      </article>
    </div>
    <p><a href="/processes/">All processes</a> · <a href="/guides/">All guides</a> · <a href="/glossary/">Glossary</a></p>
  </section>

  <section class="portal-section" data-section="applications">
    <p class="kicker">Applications landscape</p>
    <p>Nylon's application map, organised as an industry landscape rather than a parts catalogue: the <a href="/applications/">coverage map</a> spans {APPLICATION_INDUSTRIES.length} industries × {APPLICATION_PART_FAMILIES.length} part families. {APPLICATIONS.length} guides are published — the <a href="/applications/drones/">drones &amp; UAV hub</a>, with <a href="/applications/drones/motor-mounts/">motor mounts</a> and <a href="/applications/drones/propeller-guards/">propeller guards</a> worked end to end — and {plannedCells} further cells are planned, each gated on real demand and a complete engineering kernel before it is written.</p>
  </section>

  <section class="portal-section tools-module" data-section="data-tools">
    <p class="kicker">Data &amp; tools — the service desk</p>
    <p class="tools-counts">{MATERIALS.length} material grades · {MACHINES.length} machines · {VENDORS.length} vendors</p>
    <p>Every value from a manufacturer datasheet or official specification, cited on the page; values manufacturers do not publish are omitted, never estimated.</p>
    <ul class="tools-links">
      <li><a href="/materials/">Material database</a></li>
      <li><a href="/machines/">Machine database</a></li>
      <li><a href="/compare/materials/">Compare materials</a></li>
      <li><a href="/compare/machines/">Compare machines</a></li>
      <li><a href="/calculators/powder-refresh-ratio/">Refresh ratio calculator</a></li>
      <li><a href="/calculators/part-cost/">Part cost estimator</a></li>
      <li><a href="/calculators/">All calculators</a></li>
    </ul>
  </section>

  <p class="updated">Nylon3DP is an independent industry publication and reference, not affiliated with any manufacturer — see the <a href="/editorial/">sourcing policy</a>. Last updated: {SITE.lastUpdated}</p>
</Base>
