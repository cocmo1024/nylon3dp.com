import Base from '../../layouts/Base.astro';

const guides = [
  {
    href: '/guides/pa11-vs-pa12/',
    name: 'PA11 vs PA12: which nylon powder?',
    blurb: 'The ductility-versus-balance decision at the heart of powder-bed nylon, settled with EOS, Formlabs and HP datasheet numbers.',
  },
  {
    href: '/guides/how-to-dry-nylon-filament/',
    name: 'How to dry nylon filament',
    blurb: 'Why nylon must be dried, the manufacturer-specified temperatures and times for PA6-CF, CoPA and Bambu PA filaments, and how to keep spools dry.',
  },
  {
    href: '/guides/designing-for-sls-mjf/',
    name: 'Designing parts for SLS & MJF',
