const faq = [
  {
    q: 'When and where is Formnext 2026?',
    a: 'Formnext 2026 runs Tuesday 17 to Friday 20 November 2026 at Messe Frankfurt, in Halls 11.0, 12.0 and 12.1 and the Portalhaus. Opening hours are 9:00–18:00 Tuesday to Thursday and 9:00–16:00 on Friday. The show is organised by Mesago Messe Frankfurt.',
  },
  {
    q: 'What is EOS announcing at Formnext 2026?',
    a: 'A new large-frame polymer SLS system, unveiled at 11:00 on Tuesday 17 November at the EOS booth (Hall 12.0, D71). EOS has confirmed a three-laser architecture ahead of the show; Materialise, which ran the unreleased machine in production, reports 44% higher productivity than the previous EOS platform. The full specification is being held for the unveiling — it is not published yet, and this page does not guess it.',
  },
  {
    q: 'Will the machines and powders shown at Formnext appear in the Nylon3DP databases?',
    a: 'Only when a manufacturer publishes a datasheet or specification we can cite. That is the rule for every entry in the material and machine databases. Announced products — the EOS platform, Arkema\u2019s next-generation Orgasol PA12, the TPM3D CF250 — stay on this watchlist, clearly labelled as announcements, until their documents exist.',
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
